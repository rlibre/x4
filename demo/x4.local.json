{
	"entryPoints": ["src/main.ts"],
	"outdir": "./bin",
	"copy": [
		{ "from": "./src/index.html", "to": "index.html" },
		{ "from": "./src/monaco-cdn.js", "to": "monaco/monaco.js" },
		{ "from": "../src/components/monaco/bin/monaco.css", "to": "monaco/monaco.css" },
		{ "from": "../src/components/monaco/bin/codicon-LN6W7LCM.ttf", "to": "monaco/codicon-LN6W7LCM.ttf" }
	],
	"define": {
		"X4_SOURCES": "true"
	},
	"esbuild": {
		"alias": {
			"x4js": "../src/x4.ts",
			"x4js/mapview": "../src/components/mapview/mapview.ts",
			"x4js/gantt": "../src/components/gantt/gantt.ts",
			"x4js/planner": "../src/components/planner/planner.ts",
			"x4js/monaco": "../src/components/monaco/monaco.ts",
			"x4js-package": "../package.json"
		}
	}
}
